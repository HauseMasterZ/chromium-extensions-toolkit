{
  "manifest_version": 3,
  "name": "Unified Toolkit",
  "version": "1",
  "description": "Auto Copy, Paste & Go, New Tab, YT Music Audio, YT Float Search, and WhatsApp Web Tweaks (Styling & Virtual Camera).",
  "permissions": [
    "scripting", 
    "clipboardRead", 
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "*://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "bg-service-worker.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab-page.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "Images/icon16.png",
    "48": "Images/icon48.png",
    "128": "Images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "Images/icon16.png",
      "48": "Images/icon48.png",
      "128": "Images/icon128.png"
    },
    "default_title": "Unified Toolkit",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["global-auto-copy.js"]
    },
    {
      "matches": ["*://web.whatsapp.com/*", "https://web.whatsapp.com/*"],
      "js": ["whatsapp-virtual-camera.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://web.whatsapp.com/*", "https://web.whatsapp.com/*"],
      "js": ["whatsapp-wide-style.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "run": {
      "suggested_key": {"default": "Alt+Z"},
      "description": "Paste and go"
    },
    "run_yt": {
      "suggested_key": {"default": "Alt+X"},
      "description": "Paste and search YouTube"
    },
    "run_incognito": {
      "suggested_key": {"default": "Alt+A"},
      "description": "Paste and search in Incognito"
    },
    "duplicate_tab": {
      "suggested_key": {"default": "Ctrl+Shift+K"},
      "description": "Duplicate current tab"
    }
  }
}